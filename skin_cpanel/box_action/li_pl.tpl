<div class="li_pl" pl="{id}">
    <div class="size" size="{size}"><span>{ten_size}</span></div>
    <div class="color" color="{color}" ma_mau="{ma_mau}"><span>{ten_color}</span></div>
    <div class="price_old price">
        <input type="text" name="gia_cu[]" class="price_format" disabled="disabled" placeholder="Giá niêm yết" value="{gia_cu}">
    </div>
    <div class="price_old price">
        <input type="text" name="gia_moi[]" class="price_format" disabled="disabled" placeholder="Giá bán" value="{gia_moi}">
    </div>
    <div class="price_new price">
        <input type="text" name="gia_deal[]" class="price_format" placeholder="Giá flash sale" value="{gia_deal}">
    </div>
    <div class="so_luong price">
        <input type="text" name="so_luong[]" class="price_format" placeholder="Số lượng" value="{so_luong}">
    </div>
</div>