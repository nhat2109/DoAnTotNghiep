<style>
    /* Styling cho nút Zalo */
    .zalo_support {
        margin-top: 20px;
        text-align: center;
    }

    .zalo-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 20px;
        background-color: #0084FF;
        /* Màu xanh đặc trưng của Zalo */
        color: white;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        border-radius: 5px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        /* Hiệu ứng đổ bóng */
    }

    .zalo-button:hover {
        background-color: #005BB5;
        /* Màu xanh đậm hơn khi hover */
        box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15);
        /* Hiệu ứng đổ bóng lớn hơn */
        transform: translateY(-2px);
        /* Hiệu ứng nổi lên */
    }

    /* Icon Zalo */
    .zalo-icon {
        background: url('https://img.icons8.com/color/48/000000/zalo.png') no-repeat center center;
        background-size: contain;
        width: 24px;
        height: 24px;
        margin-right: 8px;
        /* Khoảng cách giữa icon và text */
    }

    .fa-phone {
        width: 34px;
        font-size: 25px;
        height: 24px;
        margin-right: 8px;
        /* Khoảng cách giữa icon và text */
    }

    .top_giaodien .container .top_giaodien_left .hotline_support {
        margin-left: 20px;
        margin-top: 52px;
        text-align: center;
    }

    .hotline_button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 20px;
        background-color: #17b72c;
        /* Màu xanh đặc trưng của Zalo */
        color: white;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        border-radius: 5px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        /* Hiệu ứng đổ bóng */
    }

    .hotline_button:hover {
        background-color: #18c74a;
        /* Màu xanh đậm hơn khi hover */
        box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15);
        /* Hiệu ứng đổ bóng lớn hơn */
        transform: translateY(-2px);
        /* Hiệu ứng nổi lên */
    }
</style>