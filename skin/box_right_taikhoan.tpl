<div class="back_button"><i class="fa fa-long-arrow-left"></i> Quay lại</div>
<div class="title">Thông tin tài khoản</div>
<div class="account_info">
    <div class="li_input">
        <div class="li_input_left">Họ và tên</div>
        <div class="li_input_right">{name}</div>
    </div>
    <div class="li_input">
        <div class="li_input_left">Email</div>
        <div class="li_input_right">{email}</div>
    </div>
    <div class="li_input">
        <div class="li_input_left">Giới tính</div>
        <div class="li_input_right">{gioi_tinh}</div>
    </div>
    <div class="li_input">
        <div class="li_input_left">Ngày sinh</div>
        <div class="li_input_right">{ngay_sinh}</div>
    </div>
