<div class="account_info">
    <div class="li_input">
        <div class="li_input_left">Điện thoại</div>
        <div class="li_input_right">{dien_thoai}</div>
    </div>
    <div class="li_input">
        <div class="li_input_left">Mật khẩu</div>
        <div class="li_input_right"><i>************</i></div>
    </div>
