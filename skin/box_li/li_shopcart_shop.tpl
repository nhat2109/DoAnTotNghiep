<div class="shopcart-shop">
    <div class="shopcart-shop-header">
        <span class="shop-name"><i class="fa fa-home"></i> {shop_name}</span>
    </div>
    <div class="shopcart-shop-products">
        {list_products}
    </div>
    <div class="shopcart-shop-footer">
        <div class="shopcart-shop-shipping">
            <span class="fee-ship" 
                  data-tinh="{shop_tinh}" 
                  data-huyen="{shop_huyen}" 
                  data-trongluong="{trongluong}" 
                  data-subtotal="{shop_subtotal}">
                Phí ship: <b>0 đ</b>
            </span>
        </div>
        <div class="shopcart-shop-total">
            <span class="subtotal">Tạm tính: <b>{shop_subtotal} đ</b></span>
        </div>
    </div>
</div>

