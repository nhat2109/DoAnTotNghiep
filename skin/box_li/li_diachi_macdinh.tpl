<div class="li_address">
    <div class="top_address">
        <div class="name">
            <div class="text">{ho_ten}</div>
            <div class="detail"><i class="fa fa-star"></i>Mặc định</div>
        </div>
        <div class="action">
            <a href="javascript:;" class="show_update" loai="show_update_diachi" value="{id}">Cập nhật</a> | <a href="javascript:;" class="del_diachi" value="{id}">Xóa</a>
        </div>
    </div>
    <div class="bottom_address">
        <div class="email">{email}</div>
        <div class="mobile">{dien_thoai}</div>
        <div class="address"><div class="text">{dia_chi},{ten_xa},{ten_huyen},{ten_tinh}</div></div>
    </div>
</div>