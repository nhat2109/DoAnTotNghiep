<div class="li_muakem li_sub_muakem">
    <div class="check_product">
        <input type="checkbox" name="sub_id[]" value="{id}" id="product_{id}">
        <label for="product_{id}"><i class="fa fa-square-o"></i><i class="fa fa-check-square"></i></label>
    </div>
    <div class="minh_hoa">
        <a href="/product/{link}.html">
            <img src="{minh_hoa}" alt="{tieu_de}">
        </a>
    </div>
    <div class="info">
        <div class="tieude">
            <a href="/product/{link}.html">{tieu_de}</a>
        </div>
        <div class="price-old">{gia_cu}₫</div>
        <div class="thanhtien">{thanhtien}₫</div>        
    </div>
</div>