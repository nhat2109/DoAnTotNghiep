<tr class="product">
    <td class="product-image">
        <div class="product-thumbnail">
            <div class="product-thumbnail-wrapper">
                <img class="product-thumbnail-image" alt="{tieu_de}" src="{minh_hoa}">
            </div>
            <span class="product-thumbnail-quantity bg_orange" aria-hidden="true">{i}</span>
        </div>
    </td>
    <td class="product-description">
        <span class="product-description-name order-summary-emphasis">{tieu_de}</span>
        <div class="giam_gop">Giảm: <span>{giam}%</span></div>
    </td>
    <td class="product-quantity visually-hidden">{soluong}</td>
    <td class="product-price">
        <div class="gia_gop">{gia_moi}đ</div>
        <span class="order-summary-emphasis bold">{thanhtien}₫</span>
    </td>
</tr>