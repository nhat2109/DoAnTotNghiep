            <img class="img-responsive center-block" src="{minhhoa_socdo}" alt="{tieu_de}">
            <div class="product-overlay">
                <div class="add-to-cart">
                    <a href="{demo}" target="_blank">Xem thử</a>
                </div>
            </div>
        </div>
        <div class="product-des">
