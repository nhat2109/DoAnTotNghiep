<div class="li_sanpham">
    <div class="minh_hoa">
        <a href="/product/{link}.html" title="{tieu_de}">
            <span class="status"><img src="/skin/css/images/sieu_sale.png"></span>
            <button>Xem ngay</button>
            <img src="{minh_hoa}">
        </a>
    </div>
    <div class="sanpham_info">
        <div class="time_countdown">
            <i class="fa fa-clock-o"></i> <span class="timer_countdown" time="{time}" time_start="{time_start}"><span class="text_status">{text}</span> <span class="days"></span> ngày <span class="hours"></span>:<span class="minutes"></span>:<span class="seconds"></span></span>
        </div>
        <div class="tieu_de">
            <a href="/product/{link}.html" title="{tieu_de}"><h3>{tieu_de}</h3></a>
        </div>
        <div class="hr"></div>
        <div class="price_sale"><div class="price">{gia_moi}<sup>đ</sup><span class="discount">-{giam}%</span></div></div>
        <div class="price_old"><div class="price">{gia_cu}<sup>đ</sup></div><span>Số lượng <span class="so_luong">{so_luong}</span></span></div>
    </div>
</div>