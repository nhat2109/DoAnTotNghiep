<div class="li_sanpham">
    <div class="minh_hoa">
        <a href="/product/{link}.html" title="{tieu_de}">
            <img src="/skin/css/images/frame_muakem.png" class="frame" style="bottom: -50px;">
            <button>Xem ngay</button>
            <img src="{minh_hoa}">
        </a>
    </div>
    <div class="sanpham_info" style="margin-top: 30px;">
        <div class="tieu_de">
            <a href="/product/{link}.html" title="{tieu_de}"><h3>{tieu_de}</h3></a>
        </div>
        <div class="hr"></div>
        <div class="price_sale"><div class="price">{gia_moi}<sup>đ</sup><span class="discount">-{giam}%</span></div></div>
        <div class="price_old"><div class="price">{gia_cu}<sup>đ</sup></div></div>
    </div>
</div>