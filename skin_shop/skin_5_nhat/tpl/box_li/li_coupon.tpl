<div class="li_coupon">
    <div class="li_coupon_left">
        <div class="li_coupon_left_content">
            <div class="li_coupon_left_content_top">
                Mã giảm: <span class="discount">{giam}</span>
            </div>
            <div class="li_coupon_left_content_ma">
                <span class="coupon-code">{ma}</span>
                <button class="copy-btn" onclick="copyCode('{ma}', this)"><i class="fas fa-copy"></i><span>Sao chép</span></button>
            </div>
            <div class="li_coupon_left_content_time">
                HSD: {expired}
            </div>
        </div>
    </div>
</div>