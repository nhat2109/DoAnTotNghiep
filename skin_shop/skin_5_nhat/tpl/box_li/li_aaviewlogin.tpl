<div id="review-form-container" class=" mt-8">
    <div class="p-5 rounded mb-8">
      <div id="rating-stars" class="flex space-x-2 mb-4">
        <span class="star" data-value="1">&#9733;</span>
        <span class="star" data-value="2">&#9733;</span>
        <span class="star" data-value="3">&#9733;</span>
        <span class="star" data-value="4">&#9733;</span>
        <span class="star" data-value="5">&#9733;</span>
      </div>

     
      <textarea
        id="review-comment"
        class="w-full p-2 border rounded mb-4"
        rows="3"
        placeholder="Đánh giá của bạn..."
      ></textarea>
      <button
        id="submit-review"
        style="
          background-color: #e53175;
          color: white;
          padding: 12px;
          border-radius: 15px;
        "
      >
        Gửi đánh giá
      </button>
    </div>
  </div>