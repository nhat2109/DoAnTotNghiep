


  <a class="block" href="/product/{link}.html" title="{tieu_de}">
    <picture>
      <source
        media="(max-width: 480px)"
        srcset="{minh_hoa}"
      />
      <img
        class="block mx-auto w-full object-contain"
        width="100%"
        height="624"
        src="{minh_hoa}"
        alt="{tieu_de}"
        fetchpriority="high"
      />
    </picture>
  </a>

