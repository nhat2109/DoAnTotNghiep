<div class="col-md-12 col-sm-12 col-xs-12 clearfix">
    <article class="blog-item">
        <div class="blog-item-thumbnail">
            <a href="/detail/{link}.html">
                <img src="/skin_shop/css/images/loader.svg?v=508" data-src="{minh_hoa}" alt="{tieu_de}" class="img-responsive center-block" />
            </a>
        </div>
        <div class="blog-item-mains">
            <h3 class="blog-item-name"><a href="/detail/{link}.html" title="{tieu_de}">{tieu_de}</a></h3>
            <div class="post-time">
                <i class="ion ion-ios-calendar"></i> {date_post}
            </div>
            <p class="blog-item-summary margin-bottom-5">{trich}</p>
        </div>
    </article>
</div>