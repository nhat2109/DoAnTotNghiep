<li class="cart-item">
    <div class="cart-item-inner">
        <div class="cart-item-image">
            <a href="/product/{link}.html" title="{tieu_de}" target="_blank">
                <img loading="lazy" src="{minh_hoa}" alt="{tieu_de}" />
            </a>
        </div>
        <div class="cart-item-details">
            <div class="cart-item-header">
                <a href="javascript:;" title="Xóa" class="remove-item-cart" data-id="{id}" data-color="{color}" data-size="{size}">
                    
                    <i class="fa fa-times"></i>
                </a>
                <h3 class="cart-item-title">
                    <a href="/product/{link}.html" title="{tieu_de}" target="_blank">{ten_sanpham}</a>
                </h3>
            </div>
            <div class="cart-item-footer">
                <div class="cart-item-price">{gia_moi}₫</div>
                <div class="cart-item-quantity">
                    <span class="quantity-label">Số lượng:</span>
                    <span class="quantity-value">{quantity}</span>
                </div>
            </div>
        </div>
    </div>
</li>

