<div class="li_flash_sale">
    <div class="li_flash_sale_content">
        <div class="minh_hoa">
            <a href="/product/{link}.html" title="{tieu_de}">
                <img src="/thumbnail.php?w=374&img={minh_hoa}" alt="{tieu_de}">
            </a>
        </div>
        <div class="li_flash_sale_info">
            <h4 class="title-product">
                <a class="product-name line-clamp" href="/product/{link}.html" title="{tieu_de}">{tieu_de}</a>
            </h4>
            <div class="count_down" time="{expired}">
                Còn lại: <span class="time_countdown days">00</span><span class="text_count">:</span><span class="time_countdown hours">00</span><span class="text_count">:</span><span class="time_countdown minutes">00</span><span class="text_count">:</span><span class="time_countdown seconds">00</span>
            </div>
            <div class="price">
                <span class="price-old">{gia_cu}</span>
                <span class="price-new">{gia_moi}</span>
            </div>
        </div>                        
    </div>
</div>