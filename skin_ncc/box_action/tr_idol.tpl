<div class="li_idol">
	<div class="li_idol_content">
		<div class="minh_hoa">
			<img src="{avatar}" alt="{ho_ten}">
		</div>
		<div class="info">
			<div class="tieu_de"><b>Họ và tên:</b> {ho_ten}</div>
			<div class="tieu_de"><b>Sinh năm:</b> {nam_sinh}</div>
			<div class="tieu_de"><b>Chiều cao:</b> {chieu_cao}</div>
			<div class="tieu_de"><b>Cân nặng:</b> {can_nang}</div>
			<div class="tieu_de"><b>Kinh nghiệm:</b> {kinh_nghiem}</div>
			<div class="tieu_de"><b>Khung giờ livestream:</b> {time_start} - {time_end}</div>
			<div class="tieu_de"><b>Ngân sách:</b> {ngan_sach} đ/60 phút</div>
			<a href="/ncc/add-livestream?id={id}"><button class="button_idol">Đặt lịch</button></a>
		</div>		
	</div>
</div>