<div class="box-video">
    <div class="thumbnail">
        <a href="/ncc/video?id={id}">
            <img src="{minh_hoa}" alt="title" class="swiper-lazy lazy">
            <span class="video-view"><i class="fa fa-eye"></i> {view}</span>
            <div class="icon-play"></div>
        </a>
    </div>
    <div class="video-info">
        <div class="video-title">
            <h4 class="title">
                <a href="/ncc/video?id={id}" title="{tieu_de}">{tieu_de}</a>
            </h4>
        </div>
    </div>
</div>