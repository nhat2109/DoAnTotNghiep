<div class="li_shopcart_right">
    <div class="minh_hoa">
        <a href="/product/{link}.html">
            <img src="{minh_hoa}" alt="{tieu_de}">
        </a>
        <span>{i}</span>
    </div>
    <div class="info">
        <div class="tieude">
            <a href="/product/{link}.html">{tieu_de}</a>
            <div style="clear: both;"></div>
            <div class="info_product">
                {ten_size}
                {ten_color}
            </div>
            <div class="action_gop">
                <div class="giam">Giảm: <span>{giam}%</span></div>
                <div class="don">Khách hàng: <span>Chọn</span></div>
                <div class="list_kh" sp_id="{id}" sl="1" i="{i}"></div>
            </div>
        </div>
        <div class="thanhtien">
            <div class="thanhtien_gop" thanhtien_gop="{thanhtien_gop}">{thanhtien_gop}₫</div>
        </div>
    </div>
</div>