<div class="li_phanloai" pl="{id}">
    <div class="info_ma">
        <input type="text" name="ma[]" value="{ma_sp}" placeholder="Mã">
    </div>
    <div class="info_name">
        <input type="text" name="size[]" value="{ten_size}" giatri="{size}" placeholder="Kích cỡ">
        <div class="list_goiy scroll"></div>
    </div>
    <div class="info_mau">
        <input type="text" name="color[]" value="{ten_color}" giatri="{color}" ma_mau="{ma_mau}" placeholder="Màu sắc">
        <div class="list_goiy scroll"></div>
    </div>
    <div class="info_can_nang">
        <input type="text" name="can_nang[]" value="{can_nang}" placeholder="Trọng lượng (kg)">
    </div>
    <div class="info_gia">
        <input type="text" name="gia_cu[]" value="{gia_cu}" class="price_format" placeholder="Giá cũ">
    </div>
    <div class="info_gia">
        <input type="text" name="gia_moi[]" value="{gia_moi}" class="price_format" placeholder="Giá bán">
    </div>
    <div class="info_kho_sanpham_shop">
        <input type="text" name="kho_sanpham_shop[]" value="{kho_sanpham_shop}" class="price_format" placeholder="Tồn kho">
    </div>
    <div class="info_trongluongtinhship">
        <input type="text" name="trongluongtinhship[]" class="price_format" value="{can_nang_tinhship}" readonly>
    </div>
    <div class="info_action"><i class="fa fa-trash-o"></i> Xóa</div>
    <div class="info_action_copy"><i class="fa fa-files-o"></i> Sao chép</div>
</div>
