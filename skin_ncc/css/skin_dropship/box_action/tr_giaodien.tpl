<div class="li_giaodien">
	<div class="minh_hoa">
		<img src="{minh_hoa}" alt="{tieu_de}">
		<a href="{demo}" target="_blank">Xem thực tế</a>
	</div>
	<div class="info">
		<div class="tieu_de">{tieu_de}</div>
		<div class="price">
			<div class="price_old">{gia_cu}</div>
			<div class="price_new">{gia_moi}</div>
		</div>
		<button class="button_skin" id="{id}" onclick="confirm_action('set_skin', 'Xác nhận chọn giao diện', '{id}');">Chọn giao diện</button>
	</div>
</div>