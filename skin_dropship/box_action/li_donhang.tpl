<div class="li_donhang">
	<div class="avatar_donhang">
		<img src="{avatar}" onerror="this.src='/images/user.png';">
	</div>
	<div class="info_donhang">
	    <div class="ho_ten"><span class="left">{ho_ten}</span><span class="time">{date_post}</span></div>
	    <div class="dien_thoai">{dien_thoai}</div>
	    <div class="noi_dung">{noi_dung}, trị giá <span>{tong_tien}</span></div>
	</div>
</div>