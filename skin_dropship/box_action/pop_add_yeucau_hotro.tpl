<div class="pop_thirth_content pop_add_lienhe">
    <div class="tr_phanloai">
        <div class="txt">Bộ phận hỗ trợ</div>
        <div class="info">
            <select name="quy_trinh">
                <option value="">Chọn bộ phận hỗ trợ</option>
                <option value="hotro_chung">Hỗ trợ chung</option>
                <option value="don_hang">Kho và đơn hàng</option>
                <option value="san_pham">Thông tin sản phẩm</option>
                <option value="tai_chinh">Hỗ trợ tài chính</option>
            </select>
        </div>
    </div>
    <div class="tr_ghichu">
        <div class="txt">Chủ đề yêu cầu</div>
        <div class="info">
            <textarea name="noi_dung" maxlength="80"></textarea>
        </div>
    </div>
    <div class="list_button">
        <div class="left">
        </div>
        <div class="right">
            <input type="hidden" name="thanh_vien" value="{thanh_vien}">
            <button class="bg_orange" id="gui_ykien">Gửi liên hệ</button>
            <button class="bg_violet_normal hide_pop_thirth">Hủy</button>
        </div>
    </div>
</div>